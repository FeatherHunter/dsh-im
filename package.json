{
  "name": "@feather_wch/dsh-im",
  "version": "0.15.4",
  "description": "鎶婁節绉?IM 鏈哄櫒浜哄拰鍏綉 AI Office 鎺ュ叆鏈満 DeepSeek Harness锛堟敮鎸侀涔︺€佸井淇°€侀拤閽夈€佷紒涓氬井淇°€丵Q銆丼lack銆乀elegram銆丏iscord銆乄hatsApp 鍜?AI Office锛夈€?Connect nine IM channels and a public AI Office to a local DeepSeek Harness. Fork of @xmanrui/dsh-im 鈥?Feishu HTML media fix (private/custom).",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "ai-agent",
    "im",
    "instant-messaging",
    "chatbot",
    "feishu",
    "lark",
    "wechat",
    "wecom",
    "dingtalk",
    "qq",
    "slack",
    "telegram",
    "discord",
    "whatsapp",
    "ai-office"
  ],
  "author": {
    "name": "FeatherHunter",
    "url": "https://github.com/FeatherHunter"
  },
  "contributors": [
    {
      "name": "xmanrui",
      "url": "https://github.com/xmanrui"
    },
    {
      "name": "C3H3-AI",
      "url": "https://github.com/C3H3-AI"
    }
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FeatherHunter/dsh-im.git"
  },
  "homepage": "https://github.com/FeatherHunter/dsh-im#readme",
  "bugs": "https://github.com/FeatherHunter/dsh-im/issues",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "dsh-im": "bin/dsh-im.mjs"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "assets",
    "bin",
    "cordis.patch.yml",
    "lib",
    "plugin-src",
    "scripts",
    "src",
    "LICENSE",
    "README.md",
    "README.en.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node plugin-src/client/build.mjs && node plugin-src/host/build.mjs",
    "test": "node --test test/*.test.mjs test/channels/*/*.test.mjs",
    "check": "npm test && npm run build && node scripts/verify-package.mjs"
  },
  "engines": {
    "node": ">=22.19"
  },
  "dependencies": {
    "@tencent-connect/qqbot-connector": "1.2.0",
    "@tencent-connect/qqbot-nodejs": "1.0.4",
    "@wecom/aibot-node-sdk": "1.0.7",
    "dingtalk-stream": "2.1.4",
    "qrcode": "1.5.4",
    "sharp": "^0.35.3",
    "undici": "7.29.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@larksuiteoapi/node-sdk": "1.73.0",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "esbuild": "0.25.9",
    "https-proxy-agent": "5.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-test-renderer": "18.3.1",
    "semver": "7.8.5"
  }
}
